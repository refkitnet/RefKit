# Use the exact image and version from the matching RefKit release notes.
# A digest-pinned image is preferred after the first pull.
REFKIT_IMAGE=
REFKIT_VERSION=

# The supported first-release database is PostgreSQL 17.
POSTGRES_IMAGE=postgres:17.10-bookworm@sha256:4f736ae292687621d4dbe0d499ffd024a36bd2ee7d8ca6f2ccd4c800f047b394
POSTGRES_DB=refkit
POSTGRES_USER=refkit
POSTGRES_PASSWORD=

# Public HTTPS origin and loopback port used by the host reverse proxy.
APP_URL=https://refkit.example.com
REFKIT_HTTP_PORT=3000

# Generate every secret independently. Do not copy example values into production.
BETTER_AUTH_SECRET=
PAYOUT_DETAILS_ENCRYPTION_KEY=
IP_HASH_SALT=
SELF_HOSTED_SETUP_TOKEN=

# Choose smtp or resend. Production Self-Hosted deployments cannot log email.
EMAIL_DELIVERY=smtp
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Optional administration and outbound-webhook settings.
ADMIN_EMAIL_ALLOWLIST=
ADMIN_ALERT_EMAILS=
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Scheduled backup defaults. BACKUP_DIR is relative to this directory unless absolute.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_FREE_MB=1024
