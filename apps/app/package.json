{
  "name": "@refkitnet/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build -w @refkitnet/validation && node ../../scripts/stage-third-party-notices.mjs --workspace apps/app --target apps/app/public/third-party-notices.txt",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-db.ps1 start",
    "test:db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-db.ps1 stop",
    "test:db:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-db.ps1 reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-migrate.ps1",
    "db:studio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-studio.ps1",
    "db:seed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-seed.ps1",
    "db:seed:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-seed.ps1 -Reset",
    "admin:grant": "node scripts/grant-admin.mjs",
    "self-hosted:recover-admin": "node scripts/self-hosted/recover-admin.mjs"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@refkitnet/sdk": "^0.1.0",
    "@refkitnet/validation": "^0.1.0",
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.4",
    "postgres": "^3.4.7",
    "radix-ui": "^1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.17.1",
    "sonner": "^2.0.7",
    "stripe": "22.4.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
