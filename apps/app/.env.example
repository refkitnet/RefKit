# RefKit App - environment variables
# Copy to .env.local for local development.
# Self-Hosted configuration guide: ../../docs/self-hosting/configuration.md

# Deployment edition. Use self-hosted only with the documented Compose setup.
REFKIT_EDITION=cloud

# Local Postgres (default). Cluster starts on 127.0.0.1:54329 via npm run dev / db:migrate / test:db.
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/refkit_test
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/refkit_test

# Auth (Better Auth)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Cloud-only managed provider provisioning. Required in Cloud production.
# Keep this server-side and share it only with separately deployed, trusted
# provider services.
# MANAGED_CONNECTIONS_PROVISIONING_SECRET=replace-with-at-least-32-random-characters

# Email. Cloud uses Resend. Self-Hosted supports operator-owned Resend or SMTP.
EMAIL_DELIVERY=log
EMAIL_FROM_ADDRESS=auth@refkit.net
RESEND_API_KEY=re_replace_me
# Legacy Cloud alias for EMAIL_FROM_ADDRESS.
RESEND_FROM_EMAIL=auth@refkit.net
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace_me
# SMTP_PASSWORD=replace_me

# Local Stripe fixture endpoints and validation scripts (optional)
DEV_API_SECRET=replace-with-random-secret

# Affiliate payout details encryption (32 bytes, base64)
PAYOUT_DETAILS_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Permit HTTPS webhook targets that resolve to private or loopback addresses.
# Leave unset for hosted deployments. Self-hosters may opt in when needed.
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

# Click IP hashing salt
IP_HASH_SALT=replace-with-random-salt

# Public app-logo storage (Vercel Blob). Required in production only.
# Local dev (APP_URL=http://localhost:3000) stores logos under .local/app-logos/.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Self-Hosted persistent uploads and one-time first-administrator bootstrap.
# UPLOADS_DIR=/var/lib/refkit/uploads
# SELF_HOSTED_SETUP_TOKEN=replace-with-at-least-32-random-characters

# Public URLs
APP_URL=http://localhost:3000

# Release images set these automatically. Readiness uses the metadata file to
# reject an incompatible database schema.
# REFKIT_BUILD_VERSION=0.1.0
# REFKIT_SOURCE_REVISION=git-commit-sha
# REFKIT_SOURCE_URL=https://github.com/refkitnet/RefKit/tree/git-commit-sha
# REFKIT_RUNTIME_METADATA_FILE=/app/runtime-metadata.json

# Comma-separated admin emails for synchronous Stripe disconnect alerts
# ADMIN_ALERT_EMAILS=ops@refkit.net

# Comma-separated internal admin emails for dashboard/API access
# ADMIN_EMAIL_ALLOWLIST=ops@refkit.net,admin@refkit.net

# --- Stripe ---
# Production (Stripe App install on owner accounts):
#   STRIPE_SECRET_KEY (live platform key)
#   STRIPE_SECRET_KEY_TEST (test platform key for re-fetching test connected-account objects)
#   STRIPE_APP_INSTALL_URL, STRIPE_APP_SECRET
#   STRIPE_CONNECT_WEBHOOK_SECRET (live Connected-accounts webhook)
#   STRIPE_CONNECT_WEBHOOK_SECRET_TEST (test Connected-accounts webhook)
# RefKit Cloud supplies its reviewed Stripe App installation URL privately at deploy time.
# Self-Hosted does not support the managed Stripe connection in the first release.
# Register the same webhook URL in Stripe test mode and live mode.
# Local fixture mode (default on localhost without keys): no Stripe vars needed - see docs/stripe.md
# Optional local Stripe QA: uncomment below and set STRIPE_FIXTURE_MODE=false.
#
# STRIPE_FIXTURE_MODE=false
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me
#   # Live Connected-accounts webhook signing secret
# STRIPE_CONNECT_WEBHOOK_SECRET_TEST=whsec_replace_me
#   # Test Connected-accounts webhook signing secret
# STRIPE_SECRET_KEY_TEST=sk_test_replace_me
# STRIPE_APP_INSTALL_URL=https://dashboard.stripe.com/apps/install/link/replace_me
# STRIPE_APP_SECRET=absec_replace_me

# RefKit app API key (server-side only). Create one with `refkitnet init` or the dashboard.
REFKIT_API_KEY=<your-app-api-key>
